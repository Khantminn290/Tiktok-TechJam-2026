.env

# derived data cache (rebuilt automatically on first train_lib use)
runtime/cache/

# local research runs (large score arrays and disposable probes)
scratch/
results/verified_ensemble/

# per-node prediction arrays are reproducible and too large for Git. The compact
# node script, record, metrics, and resource files remain committed together.
logs/nodes/**/scores_*.npy
logs/smoke/nodes/**/scores_*.npy
logs/smoke/

# local pre-migration backups
.local-log-backups/

# local build/spec notes, not part of the deliverable
claude_code_build_prompt.md

# python
__pycache__/
*.pyc

# os
.DS_Store
