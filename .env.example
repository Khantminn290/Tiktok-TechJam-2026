# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The agent loads .env automatically; you do not need to `export` anything.
# Everything here overrides config/llm_config.json. Keys live ONLY here.
# ---------------------------------------------------------------------------

# Which backend to use: "openai" (default) or "anthropic".
PROVIDER=openai

# --- OpenAI (the shared team key goes here) --------------------------------
OPENAI_API_KEY=sk-proj-...

# Model for real, scored runs. Must exist in config/model_rates.json, or the
# budget guard falls back to a deliberately expensive rate and stops early.
OPENAI_MODEL=gpt-5.4

# Cheap model used ONLY by budget-capped smoke tests (--smoke). Keeps
# plumbing checks off full-model rates.
TEST_MODEL=gpt-5.4-mini

# --- Anthropic (alternative provider; set PROVIDER=anthropic to use) -------
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_NAME=claude-opus-5

# --- Optional overrides ----------------------------------------------------
# MODEL_NAME is the provider-neutral model override. If set, it wins over
# OPENAI_MODEL / the config file for whichever provider is active.
# MODEL_NAME=

# Number of diverse initial drafts before the search commits to a lineage.
# DRAFT_COUNT=7

# Custom OpenAI-compatible endpoint (e.g. a proxy). Leave unset for OpenAI.
# OPENAI_BASE_URL=
