+def sigmoid(x):
+    x = np.clip(x, -30.0, 30.0)
+    return 1.0 / (1.0 + np.exp(-x))
+
+
+def logit(p):
+    p = np.clip(p, 1e-6, 1 - 1e-6)
+    return np.log(p / (1.0 - p))
+
+
+def compute_video_prior_logits(splits, meta):
+    train = splits["train"]
+    n_videos = int(meta["field_dims"]["video"])
+    vids = train["video"].astype(np.int64)
+    y = train["long_view"].astype(np.float64)
+    cnt = np.bincount(vids, minlength=n_videos).astype(np.float64)
+    pos = np.bincount(vids, weights=y, minlength=n_videos).astype(np.float64)
+    global_rate = float(y.mean())
+    # Empirical-Bayes style smoothing strength.
+    beta = 20.0
+    rate = (pos + beta * global_rate) / (cnt + beta)
+    return logit(rate)
+
+
+def compute_user_positive_counts(splits, meta):
+    train = splits["train"]
+    n_users = int(meta["field_dims"]["user"])
+    users = train["user"].astype(np.int64)
+    y = train["long_view"].astype(np.float64)
+    return np.bincount(users, weights=y, minlength=n_users).astype(np.float64)
+
+
+def blended_scores(base_scores, split_data, video_prior_logits, user_pos_counts, tau):
+    users = split_data["user"].astype(np.int64)
+    videos = split_data["video"].astype(np.int64)
+    support = user_pos_counts[users]
+    alpha = support / (support + float(tau))
+    prior = video_prior_logits[videos]
+    return alpha * base_scores + (1.0 - alpha) * prior
+
+
+def evaluate_scores(splits, scores, split_name):
+    data = splits[split_name]
+    metrics = train_lib.evaluate(data["user_raw"], data["long_view"], scores)
+    return {k: float(v) for k, v in metrics.items()}
 
 
