+        # Small low-cost ensemble to reduce seed variance.
+        ensemble_seeds: List[int] = [int(args.seed), int(args.seed) + 1, int(args.seed) + 2]
+        valid_scores_list = []
+        test_scores_list = []
+        member_metrics = []
+
+        for i, seed in enumerate(ensemble_seeds):
