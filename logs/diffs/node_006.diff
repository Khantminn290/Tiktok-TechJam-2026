+def _mean_arrays(arrs):
+    out = np.array(arrs[0], dtype=np.float64, copy=True)
+    for a in arrs[1:]:
+        out += np.asarray(a, dtype=np.float64)
+    out /= float(len(arrs))
+    return out
+
+
+def _safe_selection_rule_test(user_ids, labels, candidate_dict):
+    try:
+        return selection_rule_test(user_ids, labels, candidate_dict)
+    except TypeError:
+        # Fallback for alternate signature variants if present in runtime.
+        return selection_rule_test(candidate_dict, user_ids, labels)
 
 
