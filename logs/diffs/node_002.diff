+def affinity_scores(split, user_hist, aff):
+    users = split['user']
+    videos = split['video']
+    out = np.zeros(len(users), dtype=np.float64)
+    cache_user = {}
+
+    for idx, (u, v) in enumerate(zip(users, videos)):
+        u = int(u)
+        v = int(v)
+        hist = cache_user.get(u)
+        if hist is None:
+            raw = user_hist.get(u, [])
+            hist = list(dict.fromkeys(raw[-50:]))
+            cache_user[u] = hist
+        s = 0.0
+        for h in hist:
+            if h == v:
+                s += 1.0
+            else:
+                s += aff.get(h, {}).get(v, 0.0)
+        out[idx] = s
+    return out
+
