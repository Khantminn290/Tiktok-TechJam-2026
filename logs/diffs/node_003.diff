+def user_holdout_masks(user_raw, seed=0):
+    users = np.asarray(user_raw)
+    uniq = np.unique(users)
+    rng = np.random.RandomState(seed)
+    perm = uniq.copy()
+    rng.shuffle(perm)
+    cut = len(perm) // 2
+    sel = set(perm[:cut].tolist())
+    mask_a = np.array([u in sel for u in users], dtype=bool)
+    mask_b = ~mask_a
+    return mask_a, mask_b
+
+
+def eval_subset(user_ids, labels, scores, mask):
+    return train_lib.evaluate(np.asarray(user_ids)[mask], np.asarray(labels)[mask], np.asarray(scores)[mask])
+
