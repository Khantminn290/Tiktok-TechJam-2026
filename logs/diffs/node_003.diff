+def write_outputs(output_dir, metrics, scores_valid, scores_test):
+    ensure_dir(output_dir)
+    with open(os.path.join(output_dir, "metrics.json"), "w") as f:
+        json.dump({k: float(v) for k, v in metrics.items()}, f)
