+def rule_from_topk(name, ks):
+    def _rule(epoch_scores):
+        items = sorted(epoch_scores.items(), key=lambda kv: kv[1], reverse=True)
+        chosen = [ep for ep, _ in items[:ks]]
+        return chosen
+    _rule.__name__ = name
+    return _rule
+
+
+def build_rules():
+    return {
+        'best1': rule_from_topk('best1', 1),
+        'top2_mean': rule_from_topk('top2_mean', 2),
+        'top3_mean': rule_from_topk('top3_mean', 3),
+        'top5_mean': rule_from_topk('top5_mean', 5),
+    }
+
+
+def mean_scores(arrs):
+    if len(arrs) == 1:
+        return arrs[0]
+    out = np.zeros_like(arrs[0], dtype=np.float64)
+    for a in arrs:
+        out += a.astype(np.float64)
+    out /= float(len(arrs))
+    return out.astype(np.float32)
 
 
