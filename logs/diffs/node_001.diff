+def pav_isotonic(y, w=None):
+    y = np.asarray(y, dtype=np.float64)
+    n = y.size
+    if w is None:
+        w = np.ones(n, dtype=np.float64)
+    else:
+        w = np.asarray(w, dtype=np.float64)
+    level = np.empty(n, dtype=np.float64)
+    weight = np.empty(n, dtype=np.float64)
+    start = np.empty(n, dtype=np.int64)
+    end = np.empty(n, dtype=np.int64)
+    m = 0
+    for i in range(n):
+        level[m] = y[i]
+        weight[m] = w[i]
+        start[m] = i
+        end[m] = i
+        while m > 0 and level[m - 1] > level[m]:
+            new_w = weight[m - 1] + weight[m]
+            new_level = (weight[m - 1] * level[m - 1] + weight[m] * level[m]) / new_w
+            level[m - 1] = new_level
+            weight[m - 1] = new_w
+            end[m - 1] = end[m]
+            m -= 1
+        m += 1
+    out = np.empty(n, dtype=np.float64)
+    for j in range(m):
+        out[start[j]:end[j] + 1] = level[j]
+    return out
+
